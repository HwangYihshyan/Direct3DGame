  <!--
    ============================================================
    シェーダ
      fxc がビルド時にコンパイルし、
      $(OutDir)Shaders\ 以下へ .cso を書き出す。
      実行時は PostEffect が "Shaders\*.cso" を読む。
    ============================================================
  -->
  <ItemGroup>
    <FxCompile Include="Shaders\ScreenVS.hlsl">
      <ShaderType>Vertex</ShaderType>
      <ShaderModel>5.0</ShaderModel>
      <EntryPointName>main</EntryPointName>
      <ObjectFileOutput>$(OutDir)Shaders\%(Filename).cso</ObjectFileOutput>
    </FxCompile>
    <FxCompile Include="Shaders\ScreenPS.hlsl">
      <ShaderType>Pixel</ShaderType>
      <ShaderModel>5.0</ShaderModel>
      <EntryPointName>main</EntryPointName>
      <ObjectFileOutput>$(OutDir)Shaders\%(Filename).cso</ObjectFileOutput>
    </FxCompile>
  </ItemGroup>
