  <!--
    ============================================================
    Assets を出力フォルダへコピーする。
    GameScene が "Assets\texture\forest.png" を相対パスで開くため、
    exe と同じ場所に Assets が無いと起動に失敗する。
    ============================================================
  -->
  <Target Name="CopyGameAssets" AfterTargets="Build">
    <ItemGroup>
      <GameAssets Include="$(ProjectDir)Assets\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(GameAssets)" DestinationFiles="@(GameAssets->'$(OutDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
